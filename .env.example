# InfoDengue API
INFODENGUE_BASE_URL=https://info.dengue.mat.br/api/alertcity

# OpenMeteo API
OPENMETEO_BASE_URL=https://archive-api.open-meteo.com/v1/archive

# DuckDB
DUCKDB_PATH=data/processed/arboviroses.duckdb

# MinIO (local S3)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=arboviroses

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5000

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Groq — só no ambiente. Não commitar valor real.
GROQ_API_KEY=

# Kafka (host). Dentro da rede Compose o broker interno é kafka:29092.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# CORS da API. Use origens separadas por vírgula fora do laboratório.
CORS_ORIGINS=*